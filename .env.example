CORTES_EB_HOME=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Banco do painel (PostgreSQL / Supabase). Coloque estas linhas em ~/.cortes-eb/.env
# DATABASE_URL: conexão usada pelo painel (no Supabase, a do "Session pooler").
# DIRECT_DATABASE_URL: conexão direta, usada só para aplicar as migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Opcional: chave mestra (32 bytes em base64) que protege as chaves de API guardadas.
# Sem ela, o cortes-eb cria ~/.cortes-eb/master.key com permissão 600.
CORTES_EB_MASTER_KEY=
