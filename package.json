{
  "name": "cortes-eb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de cortes verticais para Shorts a partir de vídeos longos",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cortes-eb": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p remotion/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@remotion/bundler": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/install-whisper-cpp": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "nest-commander": "3.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "remotion": "4.0.544",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
