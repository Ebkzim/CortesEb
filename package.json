{
  "name": "cortes-eb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Motor de cortes verticais para Shorts a partir de vídeos longos",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cortes-eb": "dist/main.js"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p remotion/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "instalar": "node scripts/instalar.mjs",
    "painel": "node dist/main.js ui"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.9",
    "@fastify/static": "10.1.11",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-fastify": "12.5.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@remotion/bundler": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/install-whisper-cpp": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "better-sqlite3": "12.6.2",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "nest-commander": "3.21.0",
    "opentype.js": "2.0.0",
    "playwright-core": "1.64.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "remotion": "4.0.544",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.6.2": true,
    "esbuild@0.28.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@swc/core@1.16.22": true
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
